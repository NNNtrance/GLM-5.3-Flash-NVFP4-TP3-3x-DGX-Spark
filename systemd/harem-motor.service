[Unit]
Description=GLM-5.3-Flash engine (harem/glm53-lil:t10) - starts at boot
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Environment=ENV_FILE=@HOME@/glm3x/.env.lil-t10
Environment=HOME=@HOME@
WorkingDirectory=@HOME@/glm3x
ExecStartPre=/bin/bash @HOME@/glm3x/scripts/engine-preflight.sh
ExecStart=/bin/bash @HOME@/glm3x/scripts/start-lil.sh
ExecStop=/usr/bin/docker stop -t 60 harem_glm53_lil
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
