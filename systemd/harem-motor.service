[Unit]
Description=GLM-5.3-Flash engine (harem/glm53-lil:t10) - starts at boot
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=glm53
Environment=ENV_FILE=/home/glm53/glm3x/.env.lil-t10
Environment=HOME=/home/glm53
WorkingDirectory=/home/glm53/glm3x
ExecStartPre=/bin/bash /home/glm53/glm3x/scripts/engine-preflight.sh
ExecStart=/bin/bash /home/glm53/glm3x/scripts/start-lil.sh
ExecStop=/usr/bin/docker stop -t 60 harem_glm53_lil
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
