# Cluster addressing for the operator-side scripts in this directory.
#   cp cluster.env.example cluster.env      then edit cluster.env
# cluster.env is gitignored. Nothing here is read by the engine itself — the
# engine reads its own env file (env.example -> .env.lil-t10 on each node).
#
# The addresses below are RFC 5737 documentation addresses. Replace them with
# your own management addresses.

# SSH targets. Anything ssh can reach: a host alias from ~/.ssh/config, or
# user@address. The scripts only ever run: systemctl, docker, free, cat.
HEAD_HOST=head
WORKER1_HOST=worker-1
WORKER2_HOST=worker-2

# The OpenAI-compatible endpoint. Only the head serves it (rank 0).
API=http://192.0.2.10:8000

# systemd unit and container name. These carry the HAREM name because the
# image, the unit and the container are all named that way in this recipe;
# see the repository README.
SERVICE=harem-motor
CONTAINER=harem_glm53_lil

# Path of the engine env file ON EACH NODE, relative to that node's home directory
# (ssh starts in the home directory, so a relative path is what works here).
ENGINE_ENV_FILE=glm3x/.env.lil-t10
