# Engine env file for scripts/start-lil.sh, image harem/glm53-lil:t10.
# This is the production configuration ("t10"): TP=3 + expert parallelism +
# marlin MoE, DFlash2 k=7, full CUDA graphs + AOT, mamba cache align, no KV pin.
#
#   cp env.example ~/glm3x/.env.lil-t10          then edit the three per-node lines
#   ENV_FILE=$HOME/glm3x/.env.lil-t10 ~/glm3x/scripts/start-lil.sh 0
#   DRY_RUN=1 ENV_FILE=$HOME/glm3x/.env.lil-t10 ~/glm3x/scripts/start-lil.sh 0
#
# =============================================================================
# PER-NODE VALUES — DO NOT COPY THIS FILE BETWEEN NODES
# =============================================================================
# Exactly three lines differ per node: NODE_RANK, HOST_IP and
# NCCL_MESH_PLUGIN_DIR (the last one only if the install path differs).
#
#   head      NODE_RANK=0    HOST_IP=<head management IP>
#   worker-1  NODE_RANK=1    HOST_IP=<worker-1 management IP>
#   worker-2  NODE_RANK=2    HOST_IP=<worker-2 management IP>
#
# MASTER_ADDR is the HEAD's management address on ALL THREE nodes.
#
# Why not scp the file: we lost an evening to a copied env file that still
# carried the head's NODE_RANK and HOST_IP. Two ranks then announced
# themselves as rank 0, the rendezvous never completed, and the failure
# surfaced far from its cause. Derive each node's copy with sed instead:
#
#   scp env.example worker-1:~/glm3x/.env.lil-t10
#   ssh worker-1 "sed -i -e 's/^NODE_RANK=.*/NODE_RANK=1/' \
#                        -e 's/^HOST_IP=.*/HOST_IP=192.0.2.11/' \
#                        ~/glm3x/.env.lil-t10"
#
# Then verify before starting anything:
#   for h in head worker-1 worker-2; do \
#     ssh $h "grep -E '^(NODE_RANK|HOST_IP|MASTER_ADDR)=' ~/glm3x/.env.lil-t10"; done

# --- identity / fabric -----------------------------------------------------
NODE_RANK=0                        # PER NODE: head=0, worker-1=1, worker-2=2
HOST_IP=192.0.2.10                 # PER NODE: this node's own MANAGEMENT address
MASTER_ADDR=192.0.2.10             # SAME ON ALL NODES: the head's management address
MASTER_PORT=29521                  # Rendezvous port; any free port, same on all nodes
GLOO_IFACE=enP7s7                  # Management NIC name (ip -br link); NOT the fabric NIC
TRANSPORT=mesh                     # mesh = NCCL mesh plugin over the QSFP triangle; socket = fallback over GLOO_IFACE
NCCL_MESH_PLUGIN_DIR=$HOME/glm3x/nccl-mesh   # Directory holding libnccl-net-mesh.so; mounted read-only into the container
NCCL_DEBUG=WARN                    # NCCL verbosity; INFO only while diagnosing (it is very loud)
NCCL_MESH_DEBUG=1                  # Mesh plugin prints the peer pairs it resolved — worth keeping on
# FABRIC_PREFIX=198.51.100.        # Optional: leading octets of your FABRIC addressing. If set,
                                   # start-lil.sh refuses a MASTER_ADDR/HOST_IP from that range,
                                   # which is otherwise a silent rendezvous hang

# --- shape -----------------------------------------------------------------
NNODES=3                           # Number of nodes in the rendezvous
TP_SIZE=3                          # Tensor parallel = 3; the model does not fit on fewer GB10 nodes
PP_SIZE=1                          # Pipeline parallelism unused (never tested here)
ENABLE_EP=1                        # Expert parallelism; MANDATORY at TP=3 (288 experts split 96/96/96, the 2048-wide routed intermediate does not split by 3)
# marlin is the ONLY SM12x MoE backend in this fork that accepts expert maps
# (b12x, flashinfer_b12x and cutlass all refuse expert maps). Known, unmeasured
# cost: marlin is weight-only, so this checkpoint's W4A4 activation scales are
# dropped and the MoE runs FP4 weights / BF16 activations.
MOE_BACKEND=marlin                 # marlin | b12x | flashinfer_b12x | cutlass — only marlin works with EP
SPEC_METHOD=dflash                 # dflash = DFlash2 drafter; empty disables speculative decoding
DFLASH_DRAFT_TP=1                  # Draft tensor parallelism; must be 1 or equal to TP_SIZE, nothing else
ENFORCE_EAGER=0                    # 0 = capture CUDA graphs (production). 1 = eager: +12% KV pool, -22% single-stream speed
BLOCK_SIZE=256                     # KV block size; 128 is rejected by the fp8 KV kernel, 256 is the smallest valid value

# --- capacity --------------------------------------------------------------
GPU_MEMORY_UTILIZATION=0.88        # Production value. Start at 0.85 and climb one step at a time with memory-ladder-step.sh
MAX_NUM_SEQS=8                     # Max concurrent sequences; 8 gave +20% aggregate over 4 and removed the queue
MAX_NUM_BATCHED_TOKENS=2048        # Prefill batch. 8192 costs 28% of the KV pool for no speed. 4096 (the lab default) was never A/B'd here
MAX_MODEL_LEN=1000000              # 1M context; verified with a 997,952-token needle run
KV_CACHE_DTYPE=fp8                 # fp8 KV. NVFP4 KV doubles the divergence, so it stays fp8
KV_CACHE_MEMORY=                   # EMPTY = no KV pin, vLLM profiles the pool. Pinning buys pool but removes the activation safety margin

# --- paths -----------------------------------------------------------------
IMAGE=harem/glm53-lil:t10          # Engine image built from patches/Dockerfile.t10
NAME=harem_glm53_lil               # Container name; the systemd ExecStop stops this name
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-lil-nvfp4   # Target checkpoint on the host (186 GB, same path on all three nodes)
MODEL_PATH=/models/glm-5.3-flash-lil-nvfp4         # Where it is mounted inside the container
DRAFT_HOST_PATH=/var/tmp/dflash2-draft             # DFlash2 drafter on the host
DRAFT_PATH=/models/dflash2-draft                   # Where the drafter is mounted inside the container
CACHE_HOST_PATH=/var/tmp/glm53-lil-cache           # Triton / b12x / HF cache; keep it, a cold cache costs minutes at start
SERVED_MODEL_NAME=glm-5.3-flash    # The model name clients send in their requests
PORT=8000                          # OpenAI-compatible port on the head
CPUSET=5-9,15-19                   # CPU pinning. Kept, but the gain was never proven — the cores are heterogeneous

# --- serving behaviour -----------------------------------------------------
REASONING_PARSER=deepseek_r1       # What the model card asks for. The lab manifest renders glm45; not A/B'd on this line
REASONING_EFFORT=low               # Only "low" and "high" are honoured; anything else (and omitting it) silently means "max"
SKIP_MM_PROFILING=1                # Skip the multimodal profiling pass; it costs memory we need
MM_IMAGE_LIMIT=4                   # Max images per prompt; the limit was added after an out-of-memory crash
MM_ENCODER_TP_MODE=data            # Vision tower has 16 heads and 16 % 3 != 0, so the encoder runs data-parallel
MM_PROCESSOR_CACHE_GB=0            # No multimodal processor cache
LANGUAGE_MODEL_ONLY=0              # 1 would drop the vision tower entirely

# --- compile / graph knobs -------------------------------------------------
# These four belong with ENFORCE_EAGER=0. Under --enforce-eager there is no
# torch.compile to feed and they do nothing.
VLLM_USE_AOT_COMPILE=1             # Ahead-of-time compile the captured graphs
VLLM_USE_MEGA_AOT_ARTIFACT=1       # One combined AOT artifact instead of many
VLLM_USE_STANDALONE_COMPILE=1      # Compile out of process
VLLM_USE_V2_MODEL_RUNNER=1         # v2 model runner (what the lab recipe renders)
# DeepGEMM is on by default on GB10 and the MXFP8 MTP layer it would serve is
# skipped under dflash, so it is not on the hot path. Uncomment only to isolate
# a fault, and say so when you report a number measured that way.
# VLLM_USE_DEEP_GEMM=0
B12X_POLICY_MODE=auto              # b12x kernel policy; its GB10 tables do not cover our TP=3 shape, so it falls back to heuristics
OMP_NUM_THREADS=16                 # Thread cap on a 20-core node

# --- extras ----------------------------------------------------------------
# EXTRA_ENV="FOO=1 BAR=2"          # Extra -e flags passed to docker run
EXTRA_ARGS=                        # Extra flags appended to the vllm command line
INSTANTTENSOR_COPY=false           # instanttensor loader: map, do not copy
DRAFT_LOAD_FORMAT=safetensors      # Drafter must load via safetensors; instanttensor + our head padding segfaults
MAMBA_CACHE_MODE=align             # Lab default; A/B'd here as neutral for speed and acceptance
